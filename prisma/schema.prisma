// Prisma schema for Tulkit multi-user SaaS with subscriptions
// Uses Supabase Postgres for storage + Supabase Auth for users.
// The `userId` fields store the Supabase auth.users.id (UUID string).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Each user has one business profile (1:1 with Supabase auth user)
// Also stores their role + subscription state.
model BusinessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique // Supabase auth user ID

  // Business details
  name              String   @default("Your Business Name")
  email             String?
  phone             String?
  address           String?
  vatNumber         String?
  bankName          String?
  bankAccount       String?
  bankBranch        String?
  swift             String?
  logoDataUrl       String?
  accentColor       String   @default("#0E7C9C")
  currency          String   @default("ZAR")
  currencySymbol    String   @default("R")
  invoicePrefix     String   @default("INV")
  quotePrefix       String   @default("QUO")
  nextInvoiceNumber Int      @default(1)
  nextQuoteNumber   Int      @default(1)
  defaultTaxRate    Float    @default(15)
  defaultPaymentTerms String @default("Payment due within 7 days of issue date.")

  // Role + subscription
  role              String   @default("user") // "admin" | "user"
  subscriptionStatus String  @default("none") // "none" | "trial" | "active" | "expired"
  subscriptionExpiresAt DateTime?
  subscriptionActivatedAt DateTime?
  trialExpiresAt    DateTime? // when the 30-day free trial ends
  // Comma-separated feature keys allocated to this user (when subscription active)
  // e.g. "pdf_download,whatsapp_share,email_share,custom_branding"
  allocatedFeatures String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_profiles")
}

model Client {
  id        String   @id @default(cuid())
  userId    String // Supabase auth user ID — owner of this client

  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  vatNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents InvoiceDocument[]

  @@index([userId])
  @@map("clients")
}

model InvoiceDocument {
  id          String   @id @default(cuid())
  userId      String // Supabase auth user ID — owner of this document
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type        String   // "invoice" | "quote"
  number      String
  status      String   // "draft" | "sent" | "viewed" | "paid" | "overdue" | "converted"

  // Snapshot of client at doc creation (so historical docs stay accurate)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientCompany   String?
  clientAddress   String?
  clientVatNumber String?

  issueDate  String
  dueDate    String
  taxRate    Float
  globalDiscountPercent Float @default(0)
  notes      String?
  paymentTerms String?

  // For quote → invoice conversion tracking
  convertedFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sentAt    DateTime?
  paidAt    DateTime?

  items     LineItem[]

  @@index([userId])
  @@map("invoice_documents")
}

model LineItem {
  id              String  @id @default(cuid())
  documentId      String
  document        InvoiceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  description     String
  quantity        Float
  unitPrice       Float
  discountPercent Float   @default(0)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("line_items")
}

// Audit trail for platform-admin actions (subscribe, revoke, delete).
// Written by src/lib/audit.ts — logging failures never block the action.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String   // Supabase auth user ID of the admin who performed the action
  adminEmail   String?
  action       String   // "activate_subscription" | "revoke_subscription" | "delete_user"
  targetUserId String   // Supabase auth user ID of the affected user
  targetEmail  String?
  details      String?  // JSON string with action specifics (duration, features, counts)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_log")
}
