From 29937e793a0e3c5d417fb27bb97a2f5ae2981134 Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Mon, 16 Nov 2026 13:22:37 +0000
Subject: [PATCH] Pin terms and notes to the bottom in fine print
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Terms and notes now sit at the very bottom of the page — screen preview
and exported/shared PDF alike — in a smaller, still-readable fine-print
style, directly above the contact line and the Powered by Tulkit strip.

- PDF: the TERMS/NOTES block is measured, wrapped and bottom-anchored so
  it ends a fixed 8pt above the footer divider regardless of how much
  content sits above it. If a very long note would ever reach the totals
  or banking block, lines are trimmed with an ellipsis so the two can
  never collide.
- PDF font sizes: labels 7pt bold, body 8pt (previously 9pt/9pt).
- Screen preview: the page is now an A4-proportioned flex column, so
  short documents show the same bottom-pinned fine print instead of it
  floating under the totals; long documents still grow naturally. Body
  11px, labels 9px, mirroring the PDF proportions.
- Payment details (banking) stay in flow after the totals — only terms
  and notes moved.
---
 src/components/invoice-preview.tsx | 46 +++++++++-------
 src/lib/pdf.ts                     | 86 ++++++++++++++++++++++--------
 2 files changed, 90 insertions(+), 42 deletions(-)

diff --git a/src/components/invoice-preview.tsx b/src/components/invoice-preview.tsx
index 56aa018..b2457b6 100644
--- a/src/components/invoice-preview.tsx
+++ b/src/components/invoice-preview.tsx
@@ -15,11 +15,11 @@ export function InvoicePreview({ business, doc }: Props) {
   const client = doc.clientSnapshot;
 
   return (
-    <div className="bg-white text-neutral-900 shadow-sm border rounded-lg overflow-hidden relative">
+    <div className="bg-white text-neutral-900 shadow-sm border rounded-lg overflow-hidden relative flex flex-col aspect-[210/297]">
       {/* accent top band */}
       <div className="h-1.5" style={{ backgroundColor: accent }} />
 
-      <div className="p-6 sm:p-8 space-y-6">
+      <div className="p-6 sm:p-8 flex flex-col gap-6 flex-1">
         {/* Header band 1 — logo (left) + document meta (right), mirrors the PDF header */}
         <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
           {/* Left: logo */}
@@ -247,25 +247,31 @@ export function InvoicePreview({ business, doc }: Props) {
           </div>
         )}
 
-        {doc.paymentTerms && (
-          <div className="text-xs">
-            <div className="font-semibold text-neutral-500 uppercase tracking-wider text-[10px]">
-              Terms
-            </div>
-            <div className="mt-1 text-neutral-700 break-words whitespace-pre-wrap">
-              {doc.paymentTerms}
-            </div>
-          </div>
-        )}
+        {/* Terms + notes — pinned to the bottom of the page, just above the
+            footer strip, in fine print. Mirrors the PDF layout. */}
+        {(doc.paymentTerms || doc.notes) && (
+          <div className="mt-auto space-y-3">
+            {doc.paymentTerms && (
+              <div className="text-[11px] leading-snug">
+                <div className="font-semibold text-neutral-500 uppercase tracking-wider text-[9px]">
+                  Terms
+                </div>
+                <div className="mt-1 text-neutral-700 break-words whitespace-pre-wrap">
+                  {doc.paymentTerms}
+                </div>
+              </div>
+            )}
 
-        {doc.notes && (
-          <div className="text-xs">
-            <div className="font-semibold text-neutral-500 uppercase tracking-wider text-[10px]">
-              Notes
-            </div>
-            <div className="mt-1 text-neutral-700 break-words whitespace-pre-wrap">
-              {doc.notes}
-            </div>
+            {doc.notes && (
+              <div className="text-[11px] leading-snug">
+                <div className="font-semibold text-neutral-500 uppercase tracking-wider text-[9px]">
+                  Notes
+                </div>
+                <div className="mt-1 text-neutral-700 break-words whitespace-pre-wrap">
+                  {doc.notes}
+                </div>
+              </div>
+            )}
           </div>
         )}
       </div>
diff --git a/src/lib/pdf.ts b/src/lib/pdf.ts
index 8d76699..77b68a8 100644
--- a/src/lib/pdf.ts
+++ b/src/lib/pdf.ts
@@ -482,30 +482,72 @@ export function generateInvoicePdf({ business, doc, user, tulkitIconDataUrl }: P
     afterTableY += 8;
   }
 
-  // ----- Payment terms + notes -----
-  if (doc.paymentTerms) {
-    pdf.setFont("helvetica", "bold");
-    pdf.setFontSize(9);
-    pdf.setTextColor(120, 120, 120);
-    pdf.text("TERMS", margin, afterTableY);
-    afterTableY += 12;
-    pdf.setFont("helvetica", "normal");
-    pdf.setTextColor(60, 60, 60);
-    const wrapped = pdf.splitTextToSize(doc.paymentTerms, pageW - margin * 2);
-    pdf.text(wrapped, margin, afterTableY);
-    afterTableY += wrapped.length * 12 + 8;
-  }
+  // ----- Payment terms + notes — pinned to the bottom of the page, just
+  // above the footer strip. Fine-print sizing: clearly smaller than the body
+  // text but still readable on screen and paper. -----
+  const footerDividerY = pageH - 44;
+  const bottomLimit = footerDividerY - 8; // breathing room above the divider
+  const bottomBlocks = [
+    ...(doc.paymentTerms ? [{ label: "TERMS", text: doc.paymentTerms }] : []),
+    ...(doc.notes ? [{ label: "NOTES", text: doc.notes }] : []),
+  ];
 
-  if (doc.notes) {
-    pdf.setFont("helvetica", "bold");
-    pdf.setFontSize(9);
-    pdf.setTextColor(120, 120, 120);
-    pdf.text("NOTES", margin, afterTableY);
-    afterTableY += 12;
+  if (bottomBlocks.length > 0) {
+    const LABEL_SIZE = 7;
+    const BODY_SIZE = 8;
+    const BODY_LEADING = 10.5;
+    const LABEL_LEADING = 9;
+    const BLOCK_GAP = 7;
+
+    // Measure wrapped lines with the final body font so the block is
+    // bottom-anchored precisely: startY + totalH lands on bottomLimit.
     pdf.setFont("helvetica", "normal");
-    pdf.setTextColor(60, 60, 60);
-    const wrappedNotes = pdf.splitTextToSize(doc.notes, pageW - margin * 2);
-    pdf.text(wrappedNotes, margin, afterTableY);
+    pdf.setFontSize(BODY_SIZE);
+    const blocks = bottomBlocks.map((b) => ({
+      label: b.label,
+      lines: pdf.splitTextToSize(b.text, pageW - margin * 2) as string[],
+    }));
+
+    const blockH = (n: number) => LABEL_LEADING + n * BODY_LEADING;
+    let totalH =
+      blocks.reduce((sum, b) => sum + blockH(b.lines.length), 0) +
+      BLOCK_GAP * (blocks.length - 1);
+
+    // The block grows upward from the footer. If a very long note would ever
+    // reach the totals or banking block, trim the last block's lines with an
+    // ellipsis so the two can never collide.
+    const minY = afterTableY + 20;
+    let startY = bottomLimit - totalH;
+    if (startY < minY) {
+      const last = blocks[blocks.length - 1];
+      const removable = Math.min(
+        last.lines.length - 1,
+        Math.ceil((minY - startY) / BODY_LEADING),
+      );
+      if (removable > 0) {
+        last.lines = [
+          ...last.lines.slice(0, last.lines.length - removable),
+          "…",
+        ];
+        totalH -= removable * BODY_LEADING;
+        startY = bottomLimit - totalH;
+      }
+      if (startY < minY) startY = minY;
+    }
+
+    let y = startY;
+    for (const b of blocks) {
+      pdf.setFont("helvetica", "bold");
+      pdf.setFontSize(LABEL_SIZE);
+      pdf.setTextColor(120, 120, 120);
+      pdf.text(b.label, margin, y);
+      y += LABEL_LEADING;
+      pdf.setFont("helvetica", "normal");
+      pdf.setFontSize(BODY_SIZE);
+      pdf.setTextColor(60, 60, 60);
+      pdf.text(b.lines, margin, y);
+      y += b.lines.length * BODY_LEADING + BLOCK_GAP;
+    }
   }
 
   // ----- Footer -----
